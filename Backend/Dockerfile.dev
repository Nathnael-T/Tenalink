# Development Dockerfile for Spring Boot backend with hot reload
FROM maven:3.9-eclipse-temurin-21-alpine

WORKDIR /app

# Copy parent pom and all submodule poms
COPY pom.xml .
COPY gateway-service/pom.xml gateway-service/
COPY auth-service/pom.xml auth-service/
COPY user-service/pom.xml user-service/
COPY medical-records-service/pom.xml medical-records-service/
COPY appointment-service/pom.xml appointment-service/
COPY pharmacy-service/pom.xml pharmacy-service/
COPY admin-service/pom.xml admin-service/
COPY hospital-service/pom.xml hospital-service/

# Download dependencies (cached layer for faster rebuilds)
RUN mvn dependency:go-offline -B

# Copy source code for all modules
COPY gateway-service/src gateway-service/src
COPY auth-service/src auth-service/src
COPY user-service/src user-service/src
COPY medical-records-service/src medical-records-service/src
COPY appointment-service/src appointment-service/src
COPY pharmacy-service/src pharmacy-service/src
COPY admin-service/src admin-service/src
COPY hospital-service/src hospital-service/src

# Expose ports: 8080 for app, 5005 for debug
EXPOSE 8080 5005

# Install curl for healthcheck
RUN apk add --no-cache curl

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Run gateway-service with spring-boot:run (enables hot reload with devtools)
# devtools watches for changes and auto-restarts the app
CMD ["mvn", "-pl", "gateway-service", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]
