# Development Dockerfile for React/Vite frontend with hot reload
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server with HMR enabled
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
